{
  "name": "localmd",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run assert:no-external && npm run assert:no-design-graph",
    "dev:desktop": "vite --mode desktop --host 127.0.0.1 --port 1420 --strictPort",
    "build:desktop": "tsc -b && vite build --mode desktop --outDir dist-desktop && node scripts/assert-no-external-urls.mjs dist-desktop && node scripts/assert-desktop-artifact.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --bundles app,dmg",
    "tauri": "tauri",
    "design:graph": "vite --host 127.0.0.1 --port 4174 --strictPort",
    "preview:desktop": "vite preview --outDir dist-desktop --host 127.0.0.1 --port 4175 --strictPort",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "test:design": "playwright test -c playwright.design.config.ts",
    "test:desktop": "playwright test -c playwright.desktop.config.ts",
    "perf": "playwright test --project=perf",
    "assert:no-external": "node scripts/assert-no-external-urls.mjs",
    "assert:no-design-graph": "node scripts/assert-no-design-graph.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.11.1",
    "github-slugger": "^2.0.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "idb": "^8.0.3",
    "katex": "^0.16.47",
    "mermaid": "^11.16.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.4.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.0.0",
    "hast-util-to-html": "^9.0.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
