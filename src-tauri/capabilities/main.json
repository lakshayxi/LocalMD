{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Narrow document access for the main LocalMD window",
  "windows": [
    "main"
  ],
  "platforms": ["macOS"],
  "permissions": [
    "allow-open-document",
    "allow-read-document",
    "allow-stat-document",
    "allow-save-document",
    "allow-save-document-as",
    "allow-close-document",
    "allow-report-close-readiness",
    "allow-complete-close-flow",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
