{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // Tests may touch the filesystem; application code in src/ may not, which is
    // why this is a separate project rather than node types in tsconfig.app.json.
    "types": ["node"],
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "noEmit": true,
    "skipLibCheck": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo"
  },
  // src is included so tests can import it. It is deliberately also checked by
  // tsconfig.app.json, which has no node types — that project, not this one, is
  // what keeps Node APIs out of application code.
  "include": ["test", "e2e", "src", "playwright.config.ts", "vitest.config.ts"]
}
